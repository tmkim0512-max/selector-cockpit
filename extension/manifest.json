{
  "manifest_version": 3,
  "name": "Selector Cockpit",
  "version": "0.1.0",
  "description": "Hover any element to see selector candidates with their uniqueness; reconcile Page Object JSON against the live page.",
  "minimum_chrome_version": "116",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:4777/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "key": ""
}
