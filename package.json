{
  "name": "selector-cockpit",
  "version": "0.1.0",
  "description": "Chrome DevTools extension + local server + MCP server to inspect selector uniqueness in a live browser and reconcile it with Page Object (POM) JSON.",
  "license": "MIT",
  "author": "Kim Taemin",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "cockpit": "node scripts/cockpit.mjs",
    "server": "node server/server.js",
    "mcp": "node mcp/index.js",
    "test": "npm run test:unit && npm run test:e2e && npm run test:mcp",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:mcp": "node --test \"tests/mcp/*.test.mjs\"",
    "test:demo": "DEMO_NETWORK=1 node --test tests/e2e/demo-site.test.mjs",
    "red-check": "node scripts/red-check.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.64.1",
    "zod": "^3.25.0"
  }
}
